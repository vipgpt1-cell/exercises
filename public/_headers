# Netlify headers (also applied to drag-and-drop deploys).
# Pages and the offline worker must always be checked for a new version.
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache

# Files in /assets have a content hash in their name, so they can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Links can carry age or a name in the URL; never pass them on to other sites.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
